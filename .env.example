# Copy to .env and adjust. Used by docker-compose.yml.

# Turn on the Tailscale service (HTTPS for the phone). Remove this line to run only the app.
COMPOSE_PROFILES=tailscale

# Tailscale admin console > Settings > Keys > Generate auth key (reusable is handy). Also enable MagicDNS and HTTPS Certificates in DNS settings.
TS_AUTHKEY=
TS_HOSTNAME=finfamily

# Fixed IP of this computer on your network. When set, ports 3152 (app) and 3132 (API) listen only there. Leave empty for all interfaces.
LAN_BIND=

# Time zone: "today", recurring items and backup names follow it.
TZ=America/Sao_Paulo

# Linux user that owns ./data (run `id -u` and `id -g`).
PUID=1000
PGID=1000

BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
